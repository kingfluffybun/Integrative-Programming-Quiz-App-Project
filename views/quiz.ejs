<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= title || 'Express Quiz App' %>
    </title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/themes.css">
    <link rel="stylesheet" href="/css/mobile.css">
</head>

<body class="snoopy">

    <%- include('sidebar') %>

    <div class="main">
        <div class="container" style="max-width: 562px;">
            <div class="errorSelect"></div>
            <div class="quiz-configuration">
                <!-- <h1 style="text-align: center;"><%= title || 'Express Quiz App' %></h1>
                <p style="text-align: center; color: #666; font-size: 12px;">Test your knowledge with questions from the Open Trivia Database!</p> <br> -->
                <div class="form-group">
                    <h2>Select Quiz Length</h2>
                    <label class="num-question">
                        <input type="radio" name="length" value="5">
                        <div class="num-question-content">
                            <h3>Short</h3>
                            <p>5 Questions</p>
                            <div class="circle"></div>
                        </div>
                    </label>
                    <label class="num-question">
                        <input type="radio" name="length" value="10">
                        <div class="num-question-content">
                            <h3>Normal</h3>
                            <p>10 Questions</p>
                            <div class="circle"></div>
                        </div>
                    </label>
                    <label class="num-question">
                        <input type="radio" name="length" value="20">
                        <div class="num-question-content">
                            <h3>Long</h3>
                            <p>20 Questions</p>
                            <div class="circle"></div>
                        </div>
                    </label>
                    <label class="num-question">
                        <input type="radio" name="length" value="50">
                        <div class="num-question-content">
                            <h3>Epic</h3>
                            <p>50 Questions</p>
                            <div class="circle"></div>
                        </div>
                    </label>
                    <!-- <input type="number" id="amount" min="1" max="50" value="5" /> -->
                </div>
                
                <div class="form-group">
                    <h2>Select Quiz Difficulty</h2>
                    <label class="num-question">
                        <input type="radio" name="difficulty" value="easy">
                        <div class="num-question-content">
                            <h3>Easy</h3>
                            <div class="stars">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star-icon lucide-star"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
                            </div>
                            <div class="circle"></div>
                        </div>
                    </label>
                    <label class="num-question">
                        <input type="radio" name="difficulty" value="medium">
                        <div class="num-question-content">
                            <h3>Medium</h3>
                            <div class="stars">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star-icon lucide-star"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star-icon lucide-star"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
                            </div>
                            <div class="circle"></div>
                        </div>
                    </label>
                    <label class="num-question">
                        <input type="radio" name="difficulty" value="hard">
                        <div class="num-question-content">
                            <h3>Hard</h3>
                            <div class="stars">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star-icon lucide-star"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star-icon lucide-star"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star-icon lucide-star"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
                            </div>
                            <div class="circle"></div>
                        </div>
                    </label>
                    <label class="num-question">
                        <input type="radio" name="difficulty" value="">
                        <div class="num-question-content">
                            <h3>Any</h3>
                            <div class="circle"></div>
                        </div>
                    </label>
                </div>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <button id="start-quiz-btn">Start Quiz</button>
                    <!-- <button id="reset-quiz-btn" style="background: #6c757d">Reset</button> -->
                </div>
            </div>
            
            <div id="quiz-persistent-header"></div>
            <div id="quiz-container" style="display: none;">
            </div>
        </div>
    </div>
    <script src="/js/ui.js"></script>
    <script src="/js/quiz.js"></script>
</body>

</html>