<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/login_register.css" />
</head>
<body class="auth-page">
  <main class="auth-shell">
    <section class="auth-header">
      <h1>Welcome Back</h1>
      <p>Login with your email or username to continue.</p>
    </section>
      <% if (message) { %>
        <div class="alert alert-success"><%= message %></div>
      <% } %>
      <% if (errors && errors.length) { %>
        <div class="alert alert-error">
          <ul>
            <% errors.forEach((error) => { %>
              <li><%= error.msg %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <form class="auth-form" action="/auth/login" method="POST" novalidate>
        <div class="form-group">
          <input
            class="form-input"
            id="identifier"
            name="identifier"
            type="text"
            placeholder=" "
            value="<%= data.identifier || '' %>"
            autocomplete="username"
          />
          <label class="form-label" for="identifier">Email or Username</label>
        </div>

        <div class="form-group">
          <input
            class="form-input"
            id="password"
            name="password"
            type="password"
            placeholder=" "
            autocomplete="current-password"
          />
          <label class="form-label" for="password">Password</label>
        </div>

        <label class="form-checkbox">
          <input type="checkbox" name="remember" <%= data.remember ? 'checked' : '' %> />
          <span>Remember me</span>
        </label>

        <button type="submit" class="btn-primary">Login</button>
      </form>

    <footer class="auth-footer">
      <a class="auth-link" href="/register">Create account</a>
      <a class="auth-link" href="/recovery">Forgot password?</a>
    </footer>
  </main>
  <script src="/js/auth.js"></script>
</body>
</html>
