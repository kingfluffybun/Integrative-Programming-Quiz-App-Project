<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= title || 'Express Quiz App' %>
    </title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/themes.css">
    <link rel="stylesheet" href="/css/shop.css">
    <link rel="stylesheet" href="/css/mobile.css">
</head>

<body>
    
    <%- include('sidebar') %>

    <div class="main">
        <div class="container">
            <h1>Themes</h1>
            <div class="themes-section">
                <div class="cartoon-container" style="background-color: var(--snoopy-container-color);">
                    <img src="/shop/snoopy.png" alt="">
                    <div>
                        <h2>Peanuts</h2>
                        <button style="color: var(--snoopy-container-color);">Buy</button>
                    </div>
                </div>
                <div class="cartoon-container" style="background-color: var(--powerpuff-girls-container-color);">
                    <img src="/shop/powerpuffgirls.png" alt="">
                    <div>
                        <h2>PowerPuff Girls</h2>
                        <button style="color: var(--powerpuff-girls-container-color);">Buy</button>
                    </div>
                </div>
                <div class="cartoon-container" style="background-color: var(--spongebob-container-color);">
                    <img src="/shop/spongebob.png" alt="">
                    <div>
                        <h2>Spongebob</h2>
                        <button style="color: var(--spongebob-container-color);">Buy</button>
                    </div>
                </div>
                <div class="cartoon-container" style="background-color: var(--adventure-time-container-color);">
                    <img src="/shop/adventuretime.png" alt="" >
                    <div>
                        <h2>Adventure Time</h2>
                        <button style="color: var(--adventure-time-container-color);">Buy</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="/js/ui.js"></script>
</body>
</html>