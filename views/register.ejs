<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/login_register.css" />
</head>
<body class="auth-page">
  <main class="auth-shell">
    <section class="auth-header">
      <h1>Create Account</h1>
      <p>Register with your details and start using the quiz app.</p>
    </section>

    <% if (message) { %>
      <div class="alert alert-success"><%= message %></div>
    <% } %>
    <% if (errors && errors.length) { %>
      <div class="alert alert-error">
        <ul>
          <% errors.forEach((error) => { %>
            <li><%= error.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form class="auth-form" action="/register" method="POST" novalidate>
      <div class="form-group">
        <input
          class="form-input"
          id="fullName"
          name="fullName"
          type="text"
          placeholder=" "
          value="<%= data.fullName || '' %>"
          autocomplete="name"
        />
        <label class="form-label" for="fullName">Full Name</label>
      </div>

      <div class="form-group">
        <input
          class="form-input"
          id="email"
          name="email"
          type="email"
          placeholder=" "
          value="<%= data.email || '' %>"
          autocomplete="email"
        />
        <label class="form-label" for="email">Email</label>
      </div>

      <div class="form-group password-group">
        <input
          class="form-input"
          id="password"
          name="password"
          type="password"
          placeholder=" "
          autocomplete="new-password"
        />
        <label class="form-label" for="password">Password</label>
        <button type="button" class="password-toggle" data-target="password" aria-label="Show password">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="toggle-icon eye-icon hidden"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="toggle-icon eye-off-icon"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"/><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"/><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"/><path d="m2 2 20 20"/></svg>
        </button>
      </div>

      <div class="form-group password-group">
        <input
          class="form-input"
          id="confirmPassword"
          name="confirmPassword"
          type="password"
          placeholder=" "
          autocomplete="new-password"
        />
        <label class="form-label" for="confirmPassword">Confirm Password</label>
        <button type="button" class="password-toggle" data-target="confirmPassword" aria-label="Show password">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="toggle-icon eye-icon hidden"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="toggle-icon eye-off-icon"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"/><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"/><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"/><path d="m2 2 20 20"/></svg>
        </button>
      </div>

      <button type="submit" class="btn-primary">Register</button>
    </form>

    <footer class="auth-footer">
      <a class="auth-link" href="/login">Already have an account? Login</a>
    </footer>
  </main>
  <script src="/js/auth.js"></script>
</body>
</html>
