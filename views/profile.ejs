<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= title || 'Profile - Quiz App' %>
    </title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/themes.css">
    <link rel="stylesheet" href="/css/profile.css">
</head>

<body class="snoopy">
    <header class="site-header">
        <nav>
            <h1>Quiz</h1>
            <a href="/" id="home">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house-icon lucide-house"> <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8" /> <path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /> </svg>
                <p>Home</p>
            </a>
            <a href="/quiz" id="quiz">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-pen-icon lucide-clipboard-pen"> <path d="M16 4h2a2 2 0 0 1 2 2v2" /> <path d="M21.34 15.664a1 1 0 1 0-3.004-3.004l-5.01 5.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z" /> <path d="M8 22H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" /> <rect x="8" y="2" width="8" height="4" rx="1" /> </svg>
                <p>Quiz</p>
            </a>
            <a href="/shop">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-store-icon lucide-store"> <path d="M15 21v-5a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v5" /> <path d="M17.774 10.31a1.12 1.12 0 0 0-1.549 0 2.5 2.5 0 0 1-3.451 0 1.12 1.12 0 0 0-1.548 0 2.5 2.5 0 0 1-3.452 0 1.12 1.12 0 0 0-1.549 0 2.5 2.5 0 0 1-3.77-3.248l2.889-4.184A2 2 0 0 1 7 2h10a2 2 0 0 1 1.653.873l2.895 4.192a2.5 2.5 0 0 1-3.774 3.244" /> <path d="M4 10.95V19a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8.05" /> </svg>
                <p>Shop</p>
            </a>
            <div class="bottom">
                <a href="/">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-user-icon lucide-circle-user"> <circle cx="12" cy="12" r="10" /> <circle cx="12" cy="10" r="3" /> <path d="M7 20.662V19a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v1.662" /> </svg>
                    <p>Profile</p>
                </a>
                <div class="more">
                    <div class="more-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ellipsis-icon lucide-ellipsis"> <circle cx="12" cy="12" r="1" /> <circle cx="19" cy="12" r="1" /> <circle cx="5" cy="12" r="1" /> </svg>
                    </div>
                    <p>More</p>
                    <div class="more-content">
                        <a href="/about">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info-icon lucide-info"> <circle cx="12" cy="12" r="10" /> <path d="M12 16v-4" /> <path d="M12 8h.01" /> </svg>
                            <p>About</p>
                        </a>
                        <a>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-settings-icon lucide-settings"> <path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915" /> <circle cx="12" cy="12" r="3" /> </svg>
                            <p>Settings</p>
                        </a>
                        <a href="/auth/logout">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-log-out-icon lucide-log-out"> <path d="m16 17 5-5-5-5" /> <path d="M21 12H9" /> <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /> </svg>
                            <p>Log Out</p>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <section class="profile-section">
        <!-- Profile Header Card -->
        <div class="profile-header-card">
            <div class="profile-avatar">
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="avatar-icon">
                    <circle cx="12" cy="12" r="10" />
                    <circle cx="12" cy="10" r="3" />
                    <path d="M7 20.662V19a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v1.662" />
                </svg>
            </div>
            <div class="profile-info">
                <h2>TestProfile</h2>
                <p class="profile-email">TestProfile@gmail.com</p>
                <p class="profile-member">Member since May 7, 2026</p>
            </div>
            <div class="edit-button-container">
                <button class="btn-primary btn-edit" id="editProfileBtn">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
                Edit Profile
                </button>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="profile-nav-tabs">
            <button class="nav-tab active" data-tab="manage-profile">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
                Manage Profile
            </button>
            <button class="nav-tab" data-tab="customization">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2v20M2 12h20"></path>
                    <path d="M4.22 4.22l14.24 14.24M19.78 4.22L5.54 18.46"></path>
                </svg>
                Customization
            </button>
            <button class="nav-tab" data-tab="settings">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 1v6m0 6v6M4.22 4.22l4.24 4.24m5.08 5.08l4.24 4.24M1 12h6m6 0h6m-17.78 7.78l4.24-4.24m5.08-5.08l4.24-4.24"></path>
                </svg>
                Settings
            </button>
            <button class="nav-tab" data-tab="scores">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="23 6 13.5 15.5 8.5 10.5 1 17"></polyline>
                    <polyline points="17 6 23 6 23 12"></polyline>
                </svg>
                Scores
            </button>
        </div>

        <!-- Tab Content -->
        <div class="profile-content">
            <!-- Manage Profile Tab -->
            <div class="tab-content active" id="manage-profile">
                <h3>Manage Profile</h3>
                <div class="manage-profile-container">
                    <div class="profile-form-group">
                        <label>Full Name</label>
                        <div class="profile-input-wrapper">
                            <input type="text" value="TestProfile" class="profile-input" data-field="fullName">
                            <button class="btn-small btn-save-profile" data-field="fullName">Save</button>
                        </div>
                    </div>

                    <div class="profile-form-group">
                        <label>Email Address</label>
                        <div class="profile-input-wrapper">
                            <input type="email" value="TestProfile@gmail.com" class="profile-input" data-field="email">
                            <button class="btn-small btn-save-profile" data-field="email">Save</button>
                        </div>
                    </div>

                    <div class="profile-form-group">
                        <label>Date Joined</label>
                        <div class="profile-input-wrapper">
                            <input type="text" value="May 7, 2026" readonly class="profile-input">
                            <button class="btn-small" disabled>View</button>
                        </div>
                    </div>

                    <div class="profile-form-group">
                        <label>Password</label>
                        <div class="profile-input-wrapper">
                            <input type="password" class="profile-input" placeholder="Enter new password" data-field="password">
                            <button class="btn-small btn-save-profile" data-field="password">Change</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Customization Tab -->
            <div class="tab-content" id="customization">
                <h3>Customization</h3>

                <!-- Change Themes Section -->
                <div class="customization-section">
                    <h4>Change Themes</h4>
                    <div class="themes-grid">
                        <div class="theme-card active" data-theme="snoopy">
                            <div class="theme-preview snoopy-preview"></div>
                            <p>Snoopy</p>
                        </div>
                        <div class="theme-card" data-theme="adventure-time">
                            <div class="theme-preview adventure-preview"></div>
                            <p>Adventure Time</p>
                        </div>
                        <div class="theme-card" data-theme="spongebob">
                            <div class="theme-preview spongebob-preview"></div>
                            <p>SpongeBob</p>
                        </div>
                        <div class="theme-card" data-theme="powerpuff-girls">
                            <div class="theme-preview powerpuff-preview"></div>
                            <p>Powerpuff Girls</p>
                        </div>
                        <div class="theme-card" data-theme="we-bare-bears">
                            <div class="theme-preview bears-preview"></div>
                            <p>We Bare Bears</p>
                        </div>
                    </div>
                </div>

                <!-- Change Sounds Section -->
                <div class="customization-section">
                    <h4>Change Sounds</h4>
                    <div class="sounds-options">
                        <div class="sound-option">
                            <div class="sound-toggle">
                                <input type="checkbox" id="sound-correct" checked>
                                <label for="sound-correct">Correct Answer Sound</label>
                            </div>
                            <p class="sound-desc">Play sound when answer is correct</p>
                        </div>
                        <div class="sound-option">
                            <div class="sound-toggle">
                                <input type="checkbox" id="sound-wrong" checked>
                                <label for="sound-wrong">Incorrect Answer Sound</label>
                            </div>
                            <p class="sound-desc">Play sound when answer is wrong</p>
                        </div>
                        <div class="sound-option">
                            <div class="sound-toggle">
                                <input type="checkbox" id="sound-complete" checked>
                                <label for="sound-complete">Quiz Complete Sound</label>
                            </div>
                            <p class="sound-desc">Play sound when quiz is finished</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Settings Tab -->
            <div class="tab-content" id="settings">
                <h3>Settings</h3>
                <div class="settings-grid">
                    <div class="setting-item">
                        <div class="setting-header">
                            <h4>Sound Effects</h4>
                            <div class="toggle-switch">
                                <input type="checkbox" id="sound-effects" checked>
                                <label for="sound-effects"></label>
                            </div>
                        </div>
                        <p class="setting-desc">Enable sound effects during quizzes</p>
                    </div>
                </div>
            </div>

            <!-- Scores Tab -->
            <div class="tab-content" id="scores">
                <h3>Scores</h3>

                <!-- Score Overview Stats -->
                <div class="score-stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="23 6 13.5 15.5 8.5 10.5 1 17"></polyline>
                                <polyline points="17 6 23 6 23 12"></polyline>
                            </svg>
                        </div>
                        <h5>Overall Average</h5>
                        <p class="stat-value">82%</p>
                        <p class="stat-detail">All Quizzes</p>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="1"></circle>
                                <path d="M12 1v6m0 6v6M4.22 4.22l4.24 4.24m5.08 5.08l4.24 4.24M1 12h6m6 0h6"></path>
                            </svg>
                        </div>
                        <h5>Quizzes Taken</h5>
                        <p class="stat-value">24</p>
                        <p class="stat-detail">Total Attempts</p>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
                                <polyline points="13 2 13 9 20 9"></polyline>
                            </svg>
                        </div>
                        <h5>Highest Score</h5>
                        <p class="stat-value">98%</p>
                        <p class="stat-detail">Best Quiz</p>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 12h18M3 6h18M3 18h18"></path>
                            </svg>
                        </div>
                        <h5>Current Streak</h5>
                        <p class="stat-value">7</p>
                        <p class="stat-detail">Days</p>
                    </div>
                </div>

                <!-- Recent Scores -->
                <div class="score-section">
                    <h4>Recent Scores</h4>
                    <div class="recent-scores">
                        <div class="recent-item">
                            <div class="recent-left">
                                <p class="recent-quiz">Normal + Medium</p>
                                <p class="recent-time">Today, 2:30 PM • 5 minutes</p>
                            </div>
                            <div class="recent-right">
                                <p class="recent-score">95%</p>
                                <p class="recent-detail">9/10 correct</p>
                            </div>
                        </div>
                        <div class="recent-item">
                            <div class="recent-left">
                                <p class="recent-quiz">Short + Easy</p>
                                <p class="recent-time">Yesterday • 3 minutes</p>
                            </div>
                            <div class="recent-right">
                                <p class="recent-score">88%</p>
                                <p class="recent-detail">4/5 correct</p>
                            </div>
                        </div>
                        <div class="recent-item">
                            <div class="recent-left">
                                <p class="recent-quiz">Long + Hard</p>
                                <p class="recent-time">2 days ago • 12 minutes</p>
                            </div>
                            <div class="recent-right">
                                <p class="recent-score">72%</p>
                                <p class="recent-detail">11/15 correct</p>
                            </div>
                        </div>
                        <div class="recent-item">
                            <div class="recent-left">
                                <p class="recent-quiz">Epic + Medium</p>
                                <p class="recent-time">3 days ago • 18 minutes</p>
                            </div>
                            <div class="recent-right">
                                <p class="recent-score">91%</p>
                                <p class="recent-detail">18/20 correct</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script src="/js/profile.js"></script>
</body>

</html>
