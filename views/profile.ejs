<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= title || 'Profile - Quiz App' %>
    </title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/themes.css">
    <link rel="stylesheet" href="/css/profile.css">
    <link rel="stylesheet" href="/css/mobile.css">
</head>

<body>
    <%- include('sidebar') %>

    <div class="main profile-section" style="justify-content: flex-start;">
        <!-- Profile Header Card -->
        <div class="profile-header-card">
            <div class="profile-avatar">
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="avatar-icon"><circle cx="12" cy="12" r="10" /><circle cx="12" cy="10" r="3" /><path d="M7 20.662V19a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v1.662" /></svg>
            </div>
            <div class="profile-info">
                <h2><%= user.username %></h2>
                <p class="profile-email"><%= user.email %></p>
                <p class="profile-coins"><strong><%= user.coins %></strong> Coins</p>
                <p class="profile-member">Member since <%= user.memberSince %></p>
            </div>
            <div class="edit-button-container">
                <button class="btn-primary btn-edit" id="editProfileBtn">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                Edit Profile
                </button>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="profile-nav-tabs">
            <button class="nav-tab active" data-tab="manage-profile">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                Manage Profile
            </button>
            <button class="nav-tab" data-tab="customization">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M2 12h20"></path><path d="M4.22 4.22l14.24 14.24M19.78 4.22L5.54 18.46"></path></svg>
                Customization
            </button>
            <button class="nav-tab" data-tab="settings">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v6m0 6v6M4.22 4.22l4.24 4.24m5.08 5.08l4.24 4.24M1 12h6m6 0h6m-17.78 7.78l4.24-4.24m5.08-5.08l4.24-4.24"></path></svg>
                Settings
            </button>
            <button class="nav-tab" data-tab="scores">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 17"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
                Scores
            </button>
        </div>

        <!-- Tab Content -->
        <div class="profile-content">
            <!-- Manage Profile Tab -->
            <div class="tab-content active" id="manage-profile">
                <h3>Manage Profile</h3>
                <div class="manage-profile-container">
                    <div class="profile-form-group">
                        <label>Full Name</label>
                        <div class="profile-input-wrapper">
                            <input type="text" value="<%= user.username %>" class="profile-input" data-field="fullName">
                            <button class="btn-small btn-save-profile" data-field="fullName">Save</button>
                        </div>
                    </div>

                    <div class="profile-form-group">
                        <label>Email Address</label>
                        <div class="profile-input-wrapper">
                            <input type="email" value="<%= user.email %>" class="profile-input" data-field="email">
                            <button class="btn-small btn-save-profile" data-field="email">Save</button>
                        </div>
                    </div>

                    <div class="profile-form-group">
                        <label>Date Joined</label>
                        <div class="profile-input-wrapper">
                            <input type="text" value="<%= user.memberSince %>" readonly class="profile-input">
                            <button class="btn-small" disabled>View</button>
                        </div>
                    </div>

                    <div class="profile-form-group">
                        <label>Password</label>
                        <div class="profile-input-wrapper">
                            <input type="password" class="profile-input" placeholder="Enter new password" data-field="password">
                            <button class="btn-small btn-save-profile" data-field="password">Change</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Customization Tab -->
            <div class="tab-content" id="customization">
                <h3>Customization</h3>

                <!-- Change Themes Section -->
                <div class="customization-section">
                    <h4>Change Themes</h4>
                    <div class="themes-grid">
                        <div class="theme-card active" data-theme="snoopy">
                            <div class="theme-preview snoopy-preview"></div>
                            <p>Snoopy</p>
                        </div>
                        <div class="theme-card" data-theme="adventure-time">
                            <div class="theme-preview adventure-preview"></div>
                            <p>Adventure Time</p>
                        </div>
                        <div class="theme-card" data-theme="spongebob">
                            <div class="theme-preview spongebob-preview"></div>
                            <p>SpongeBob</p>
                        </div>
                        <div class="theme-card" data-theme="powerpuff-girls">
                            <div class="theme-preview powerpuff-preview"></div>
                            <p>Powerpuff Girls</p>
                        </div>
                    </div>
                </div>

                <!-- Change Sounds Section -->
                <div class="customization-section">
                    <h4>Change Sounds</h4>
                    <div class="sounds-options">
                        <div class="sound-option">
                            <div class="sound-toggle">
                                <input type="checkbox" id="sound-correct" checked>
                                <label for="sound-correct">Correct Answer Sound</label>
                            </div>
                            <p class="sound-desc">Play sound when answer is correct</p>
                        </div>
                        <div class="sound-option">
                            <div class="sound-toggle">
                                <input type="checkbox" id="sound-wrong" checked>
                                <label for="sound-wrong">Incorrect Answer Sound</label>
                            </div>
                            <p class="sound-desc">Play sound when answer is wrong</p>
                        </div>
                        <div class="sound-option">
                            <div class="sound-toggle">
                                <input type="checkbox" id="sound-complete" checked>
                                <label for="sound-complete">Quiz Complete Sound</label>
                            </div>
                            <p class="sound-desc">Play sound when quiz is finished</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Settings Tab -->
            <div class="tab-content" id="settings">
                <h3>Settings</h3>
                <div class="settings-grid">
                    <div class="setting-item">
                        <div class="setting-header">
                            <h4>Sound Effects</h4>
                            <div class="toggle-switch">
                                <input type="checkbox" id="sound-effects" checked>
                                <label for="sound-effects"></label>
                            </div>
                        </div>
                        <p class="setting-desc">Enable sound effects during quizzes</p>
                    </div>
                </div>
            </div>

            <!-- Scores Tab -->
            <div class="tab-content" id="scores">
                <h3>Scores</h3>

                <!-- Score Overview Stats -->
                <div class="score-stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 17"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
                        </div>
                        <h5>Overall Average</h5>
                        <p class="stat-value"><%= stats.avgScore %>%</p>
                        <p class="stat-detail">All Quizzes</p>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"></circle><path d="M12 1v6m0 6v6M4.22 4.22l4.24 4.24m5.08 5.08l4.24 4.24M1 12h6m6 0h6"></path></svg>
                        </div>
                        <h5>Quizzes Taken</h5>
                        <p class="stat-value"><%= stats.totalQuizzes %></p>
                        <p class="stat-detail">Total Attempts</p>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><polyline points="13 2 13 9 20 9"></polyline></svg>
                        </div>
                        <h5>Highest Score</h5>
                        <p class="stat-value"><%= stats.highestScore %>%</p>
                        <p class="stat-detail">Best Quiz</p>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h18M3 6h18M3 18h18"></path></svg>
                        </div>
                        <h5>Current Streak</h5>
                        <p class="stat-value"><%= stats.streak %></p>
                        <p class="stat-detail">Days</p>
                    </div>
                </div>

                <!-- Recent Scores -->
                <div class="score-section">
                    <h4>Recent Scores</h4>
                    <div class="recent-scores">
                        <% if (scores.length > 0) { %>
                            <% scores.forEach(score => { %>
                                <div class="recent-item">
                                    <div class="recent-left">
                                        <% 
                                            let quizLabel = '';
                                            const qCount = score.total_questions;
                                            const diff = (score.difficulty || 'mixed').toLowerCase();

                                            const diffFormat = diff.charAt(0).toUpperCase() + diff.slice(1);
                                            
                                            if (qCount === 5) quizLabel = 'Short';
                                            else if (qCount === 10) quizLabel = 'Normal';
                                            else if (qCount === 20) quizLabel = 'Long';
                                            else if (qCount >= 40) quizLabel = 'Epic';
                                            else quizLabel = 'Custom';

                                            if (quizLabel !== 'epic' && quizLabel !== 'custom') {
                                                quizLabel += ' - ' + diffFormat;
                                            }
                                        %>
                                        <p class="recent-quiz"><%= quizLabel %></p>
                                        <p class="recent-time"><%= score.taken_at.toLocaleString() %></p>
                                    </div>
                                    <div class="recent-right">
                                        <p class="recent-score"><%= score.score %>%</p>
                                        <p class="recent-detail"><%= score.correct_answers %>/<%= score.total_questions %> correct</p>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <p>No quiz scores found. Take a quiz to see your results!</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/profile.js"></script>
    <script src="/js/ui.js"></script>
</body>

</html>
